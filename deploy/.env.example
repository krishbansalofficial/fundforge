# Copy to deploy/.env (ignored by git) and fill in. Never commit real values.
FUNDFORGE_DOMAIN=fundforge.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Optional
# FUNDFORGE_CLOCK=1
# METRICS_PORT=9464
# BACKUP_AT=03:17
# BACKUP_KEEP_DAYS=14
# BACKUP_ON_START=0
# EDGE_SUBNET=172.30.0.0/24
# EDGE_PROXY_IP=172.30.0.2  (outside EDGE_DYNAMIC_RANGE)
# EDGE_DYNAMIC_RANGE=172.30.0.128/25
